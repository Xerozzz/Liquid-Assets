# Database configuration
# ----------------------
# Credentials for the PostgreSQL database container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=liquid_assets
POSTGRES_PORT=5432

# Connection string used by Prisma.
# For Docker Compose (the 'db' service name matches the host in the URL):
DATABASE_URL=postgres://postgres:postgres@db:5432/liquid_assets
# For running backend locally (against a containerized/local database on localhost):
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/liquid_assets

# Backend configuration
# ---------------------
# The port the backend express server listens on
PORT=4000
NODE_ENV=development
UPLOAD_DIR=./uploads
SEED_ON_START=true

# Frontend configuration
# ----------------------
# The URL pointing to the backend API. Used by the frontend build.
VITE_API_URL=http://localhost:4000

# Chatbot configuration
# ---------------------
# Gemini API key (https://aistudio.google.com/apikey) used by the /api/chat endpoint.
# gemini-flash-lite-latest is used by default: it's an alias Google keeps pointed at their
# current lightweight flash model, which avoids hardcoding a version that gets deprecated,
# and has a higher free-tier request quota than gemini-2.5-flash.
# Check current limits at https://ai.google.dev/gemini-api/docs/rate-limits
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
