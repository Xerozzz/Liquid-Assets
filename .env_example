# Database configuration
# ----------------------
# Credentials for the PostgreSQL database container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=liquid_assets
POSTGRES_PORT=5432

# Connection string used by Prisma.
# For Docker Compose (the 'db' service name matches the host in the URL):
DATABASE_URL=postgres://postgres:postgres@db:5432/liquid_assets
# For running backend locally (against a containerized/local database on localhost):
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/liquid_assets

# Backend configuration
# ---------------------
# The port the backend express server listens on
PORT=4000
NODE_ENV=development
UPLOAD_DIR=./uploads
SEED_ON_START=true

# Frontend configuration
# ----------------------
# The URL the built frontend calls for the API. Leave this EMPTY for the standard `docker
# compose up` workflow (and for any public deployment) — nginx already reverse-proxies /api/
# to the backend on the same origin, and leaving this blank makes the frontend use that relative
# path instead of an absolute URL. This matters for security: an absolute URL here bypasses
# nginx entirely (including Basic Auth, once configured — see BASIC_AUTH_USER below).
# Only set this to an absolute URL (e.g. http://localhost:4000) for the *separate* workflow of
# running `npm run dev` directly against a containerized backend (see README's "Local Frontend
# Development" section) — there's no nginx in that setup, so the frontend needs the real address.
VITE_API_URL=

# Basic Auth (recommended for any deployment reachable from the public internet)
# --------------------------------------------------------------------------------
# Leave both blank for local development — nginx serves the app with no auth, unchanged from
# before. Set both to enable HTTP Basic Auth for the whole app (frontend + API). See
# docs/DEPLOYMENT.md.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Only used by docker-compose.prod.yml (Caddy). See docs/DEPLOYMENT.md.
DOMAIN=

# Chatbot configuration
# ---------------------
# Gemini API key (https://aistudio.google.com/apikey) used by the /api/chat endpoint.
# gemini-flash-lite-latest is used by default: it's an alias Google keeps pointed at their
# current lightweight flash model, which avoids hardcoding a version that gets deprecated,
# and has a higher free-tier request quota than gemini-2.5-flash.
# Check current limits at https://ai.google.dev/gemini-api/docs/rate-limits
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
